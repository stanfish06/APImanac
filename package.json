{
  "name": "apimanac",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "module": "src/cli.ts",
  "bin": {
    "apimanac": "src/cli.ts"
  },
  "scripts": {
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "bun run src/cli.ts build",
    "compile": "bun build --compile --outfile dist/apimanac src/cli.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.21.0",
    "yaml": "2.8.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.14",
    "@types/bun": "1.3.13",
    "typescript": "5.9.3"
  }
}
